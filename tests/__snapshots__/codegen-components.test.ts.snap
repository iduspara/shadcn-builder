        <Controller
          control={form.control}
          name="checkbox-group-21"
          render={({ field, fieldState }) => (
            <Field
              className="col-span-12 col-start-auto flex self-end flex-col gap-2 space-y-0 items-start"
              data-invalid={fieldState.invalid}
            >
              <FieldLabel className="flex w-auto!">Checkbox Group</FieldLabel>

              <div className="grid w-full gap-2">
                <Controller
                  name="checkbox-group-21"
                  control={form.control}
                  render={({ field: OptionField }) => {
                    return (
                      <div
                        key="option1"
                        className="flex items-start has-[[data-checked]]:border-primary w-full space-x-3 border-0 p-0"
                      >
                        <Checkbox
                          id="checkbox-group-21-option1"
                          checked={OptionField.value?.includes("option1")}
                          onCheckedChange={(checked) => {
                            return checked
                              ? OptionField.onChange([
                                  ...(OptionField.value || []),
