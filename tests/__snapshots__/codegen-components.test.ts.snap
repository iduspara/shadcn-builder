exports[`per-component code generation > checkbox-group/plain 1`] = `
{
  "dependencies": {
    "@/components/ui/checkbox": [
      "Checkbox",
    ],
  },
  "template": "
    <div className="grid w-full gap-2">
      
        <Controller
          name="checkbox-group-21"
          control={form.control}
          render={({ field: OptionField }) => {
            return (
              <div key="option1" className="flex items-start has-[[data-checked]]:border-primary w-full space-x-3 border-0 p-0">
                  <Checkbox
                    id="checkbox-group-21-option1"
                    checked={OptionField.value?.includes("option1")}
                    onCheckedChange={(checked) => {
                      return checked
                        ? OptionField.onChange([
                            ...OptionField.value || [],
                            "option1",
                          ])
                        : OptionField.onChange(
                            OptionField.value?.filter(
                              (value: string) => value !== "option1"
                            )
                          );
                    }}
                  />
                <div className="grid gap-2 leading-none">
                  <FieldLabel className="font-medium" htmlFor="checkbox-group-21-option1">
                    Option 1
                  </FieldLabel>
                  <p className="text-sm text-muted-foreground">Option 1 Description</p>
                </div>
              </div>
            );
          }}
        />
      

        <Controller
          name="checkbox-group-21"
          control={form.control}
          render={({ field: OptionField }) => {
            return (
              <div key="option2" className="flex items-start has-[[data-checked]]:border-primary w-full space-x-3 border-0 p-0">
                  <Checkbox
                    id="checkbox-group-21-option2"
                    checked={OptionField.value?.includes("option2")}
                    onCheckedChange={(checked) => {
                      return checked
                        ? OptionField.onChange([
                            ...OptionField.value || [],
                            "option2",
                          ])
                        : OptionField.onChange(
                            OptionField.value?.filter(
                              (value: string) => value !== "option2"
                            )
                          );
                    }}
                  />
                <div className="grid gap-2 leading-none">
                  <FieldLabel className="font-medium" htmlFor="checkbox-group-21-option2">
                    Option 2
                  </FieldLabel>
                  <p className="text-sm text-muted-foreground">Option 2 Description</p>
                </div>
              </div>
            );
          }}
        />
      
    </div>
    ",
}
`;

