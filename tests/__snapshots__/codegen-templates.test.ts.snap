                    </FieldLabel>
                  </div>
                </FieldLabel>

                <FieldLabel
                  key="poor"
                  className="flex items-center has-[[data-checked]]:border-primary w-full rounded-md border p-4 space-x-2"
                  htmlFor="radio-group-0-poor"
                >
                  <RadioGroupItem value="poor" id="radio-group-0-poor" />
